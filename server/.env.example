# Configuração do servidor VoxelCraft.
# Copie para server/.env e ajuste. O .env real NÃO deve ser versionado.

# ── MySQL (Laragon) ──────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=voxelcraft

# Usuário da aplicação, criado por `npm run db:migrate`.
# Só tem acesso ao banco DB_NAME, e a senha fica só no .env.
DB_USER=voxelcraft
DB_PASSWORD=

# Credenciais de administração, usadas só pela migração.
# O padrão do Laragon é root sem senha.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# ── Servidor HTTP ─────────────────────────────────────────────────────────
PORT=3001

# ── Sessão ────────────────────────────────────────────────────────────────
SESSION_DAYS=30

# ── Contrato de geração de mundo ──────────────────────────────────────────
# Incremente sempre que a geração procedural mudar: os diffs de blocos salvos
# deixam de bater com o terreno novo e o servidor recusa a carga.
WORLDGEN_VERSION=1
